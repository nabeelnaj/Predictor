# Backend Proxy Server Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control

# Finnhub API Key (Server-side ONLY - never expose to client)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS Origins (comma-separated, no spaces)
# Example: https://your-frontend-domain.com,https://www.your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_MS=1000

# Cache TTL (seconds)
CACHE_TTL_QUOTE=10
CACHE_TTL_STATIC=60
CACHE_TTL_NEWS=10

# Logging
LOG_LEVEL=info